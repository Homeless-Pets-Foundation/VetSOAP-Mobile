# Captivet Mobile - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

EXPO_PUBLIC_API_URL=https://your-api-url.example.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_R2_BUCKET_HOSTNAME=your-bucket-name.your-account-id.r2.cloudflarestorage.com

# Native Google Sign-In. The web client is required on all native builds.
# The iOS client id and URL scheme are required for iOS builds only and come
# from a Google Cloud iOS OAuth client with bundle ID com.captivet.mobile.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# ── Monitoring (all optional — empty = SDK silently disabled) ──
# Sentry DSN for the mobile React Native project. Get it from
# Sentry → Project → Settings → Client Keys. Create a SEPARATE project
# from the server — don't reuse the server DSN, or release/source-map
# tracking will collide with the API's.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog project key (starts with `phc_`). Create a separate project from
# the server for the same reason. Host defaults to US cloud; change if using
# EU cloud or a self-hosted instance.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional — flip to "true" to enable Sentry in dev builds (off by default so
# test crashes don't pollute the production project's error feed).
# EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=true

# --- Durable-capture pilot -----------------------------------------------
# Uncomment to force the durable (ADTS AAC) recorder ON for local Metro / the
# dev-client, bypassing the server flag.
#
# Why you need it: durable capture has NEVER run in production. The client reads
# `x-durable-capture-enabled` and fails closed (src/api/client.ts), and the
# Connect server does not send that header. So every production recording uses
# the expo fallback, whose in-progress .m4a is unrecoverable if Android kills
# the process — that is the "losing parts of recordings" bug.
#
# Metro inlines EXPO_PUBLIC_* at bundle time, so after uncommenting you must run
#   npx expo start --clear
# Comment it out again when the pilot is done: it changes the recording path for
# every local session, not just the one you meant to test.
# EXPO_PUBLIC_FORCE_DURABLE_CAPTURE=true
